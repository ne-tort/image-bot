# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=            # от @BotFather
BOT_OWNER_ID=         # твой user id (админ)

# ── Выбор провайдеров (имя спеки) ─────────────────────────
# IMAGE_PROVIDER: pollinations | openai_compatible_image | grok_build | codex_subscription | gemini_oauth
# TEXT_PROVIDER:  pollinations | openai_compatible_text  | grok_build | codex_subscription | gemini_oauth
IMAGE_PROVIDER=pollinations
TEXT_PROVIDER=pollinations

# ── Вариант 1: Pollinations (бесплатно, ключ опционален) ──
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_EDIT_MODEL=klein
POLLINATIONS_TEXT_MODEL=openai

# ── Вариант 2: прямой API (OpenAI-совместимый, эндпоинты настраиваются) ──
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_EDIT_MODEL=gpt-image-1
TEXT_API_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=gpt-5-mini

# ── Вариант 3: Grok Build (подписка, не API) ──────────────
GROK_BUILD_BASE_URL=
GROK_BUILD_SESSION_TOKEN=
GROK_IMAGE_MODEL=grok-2-image
GROK_TEXT_MODEL=grok-4

# ── Вариант 4: ChatGPT/Codex подписка через команду ───────
# CODEX_BASE_URL=
# CODEX_SUBSCRIPTION_CREDENTIAL_COMMAND=python scripts/fetch_codex_token.py

# ── Вариант 5: Gemini OAuth ───────────────────────────────
GEMINI_BASE_URL=
GEMINI_SESSION_TOKEN=

# ── Лимиты (на пользователя) ──────────────────────────────
DAILY_IMAGE_LIMIT=25
HOURLY_IMAGE_LIMIT=5
DAILY_TEXT_LIMIT=100
GROUP_DAILY_LIMIT=50

# ── Хранилище ─────────────────────────────────────────────
DB_PATH=/data/imagebot.db

# ── Разное ────────────────────────────────────────────────
LOG_LEVEL=INFO
DEFAULT_LOCALE=ru       # ru | en
