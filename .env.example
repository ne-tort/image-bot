# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=            # от @BotFather
BOT_OWNER_ID=         # твой user id (админ; только он может /login)

# ── Выбор провайдеров (имя спеки) ─────────────────────────
# IMAGE_PROVIDER: pollinations | openai_compatible_image | grok_build | codex_subscription | gemini_oauth
# TEXT_PROVIDER:  pollinations | openai_compatible_text  | grok_build | codex_subscription | gemini_oauth
IMAGE_PROVIDER=pollinations
TEXT_PROVIDER=pollinations

# ── xAI Grok Build по подписке (не API-ключ) ──────────────
# 1) поставь IMAGE_PROVIDER=grok_build (и/или TEXT_PROVIDER=grok_build)
# 2) запусти бота и отправь /login в личку бота
# 3) открой ссылку, введи код — сессия сохранится в /data/auth/ и переживёт рестарт
GROK_BUILD_BASE_URL=https://api.x.ai/v1
GROK_IMAGE_MODEL=grok-imagine-image
GROK_TEXT_MODEL=grok-4.6

# ── Вариант: Pollinations (бесплатно, ключ опционален) ────
POLLINATIONS_API_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_EDIT_MODEL=klein
POLLINATIONS_TEXT_MODEL=openai

# ── Вариант: прямой API (OpenAI-совместимый, эндпоинты настраиваются) ──
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_EDIT_MODEL=gpt-image-1
TEXT_API_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=gpt-5-mini

# ── Лимиты (на пользователя) ──────────────────────────────
DAILY_IMAGE_LIMIT=25
HOURLY_IMAGE_LIMIT=5
DAILY_TEXT_LIMIT=100
GROUP_DAILY_LIMIT=50

# ── Хранилище ─────────────────────────────────────────────
DB_PATH=/data/imagebot.db
XAI_SESSION_PATH=/data/auth/xai_session.json

# ── Разное ────────────────────────────────────────────────
LOG_LEVEL=INFO
DEFAULT_LOCALE=ru       # ru | en
